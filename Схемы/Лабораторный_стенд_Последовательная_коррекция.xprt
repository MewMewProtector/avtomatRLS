    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'// НАСТРОЙКА ЖЕЛАЕМОЙ ПФ: откройте свойства ЭТОГО блока.'#13#10'// tp: требуемое время переходного процесса в секундах.'#13#10'// sigma: требуемое перерегулирование в процентах, допустимый диапазон 10..35.'#13#10'// nu: целое количество интеграторов, 0..3.'#13#10'// wc_factor: положительный множитель расчётной частоты среза.'#13#10'// pole_ratios: массив отношений частот полюсов к частоте среза.'#13#10'// zero_ratios: массив отношений частот нулей; [] означает отсутствие конечных нулей.'#13#10'// Kmin: нижняя граница усиления; 0 оставляет расчётную нормировку.'#13#10'// wmin/wmax: положительные границы диапазона ЛАЧХ, wmax больше wmin.'#13#10'// delta: положительная абсолютная полуширина полосы установления.'#13#10'// sample_dt: оставить 0.001 с; регистрация рассчитана на опыт 8 с.'#13#10'// export: 1 сохраняет результаты рядом со схемой, 0 выключает экспорт.'#13#10'// bj/aj: рассчитанные коэффициенты; вручную не менять, они обновляются при запуске.'#13#10'// Параметры выше являются СВОЙСТВАМИ блока'#13#10'// Расчёт ПФ выполняется в beforecompile общего кода страницы.'#13#10'// Здесь коэффициенты читаются из LAB_BJ/LAB_AJ и упаковываются в выход data.'#13#10'// Вход original объявлен для структуры схемы, но текущая программа его не читает.'#13#10'input original[42]; // Объявить входные сигналы; число в скобках задаёт длину массива.'#13#10'output data[42]; // Объявить выходные сигналы для передачи данных другим блокам.'#13#10'bb =[[0]]; // Записать матрица коэффициентов числителя.'#13#10'aa =[[0]]; // Записать матрица коэффициентов знаменателя.'#13#10'bb = LAB_BJ; // Прочитать общий сигнал LAB_BJ: матрица коэффициентов числителя.'#13#10'aa = LAB_AJ; // Прочитать общий сигнал LAB_AJ: матрица коэффициентов знаменателя.'#13#10'data[1] = cols(bb); // Записать количество коэффициентов числителя в начало пакета.'#13#10'data[2] = cols(aa); // Записать количество коэффициентов знаменателя.'#13#10'for(i = 1, cols(bb)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    data[2 + i] = bb[1, i]; // Перенести очередной коэффициент числителя; первая позиция равна 3.'#13#10'for(i = 1, cols(aa)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    data[22 + i] = aa[1, i]; // Перенести очередной коэффициент знаменателя; первая позиция равна 23.'</value>
     <textvalue></textvalue>
     <fconstant>'0'</fconstant>
     <script></script>
    </data>
   </visual_props>
