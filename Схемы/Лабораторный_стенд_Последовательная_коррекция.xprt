    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'const n = 8001; // Задать постоянное число точек массива.'#13#10'input v0[n], v1[n]; // Объявить входные сигналы; число в скобках задаёт длину массива.'#13#10'output t0[n], y0[n], t1[n], y1[n]; // Объявить выходные сигналы для передачи данных другим блокам.'#13#10'initialization // Выполнить один раз при инициализации нового запуска.'#13#10'    regdt = LAB_DT; // Прочитать общий сигнал LAB_DT: интервал временной шкалы.'#13#10'    for(i = 1, n) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    begin // Начало группы команд.'#13#10'        t0[i] =(i - 1) * regdt; // Записать шкала времени исходной системы в выбранную ячейку [i].'#13#10'        t1[i] = t0[i]; // Записать шкала времени системы с КУ в выбранную ячейку [i].'#13#10'    end; // Конец группы команд или секции.'#13#10'end; // Конец группы команд или секции.'#13#10'y0 = v0; // Записать исходный переходный процесс.'#13#10'y1 = v1; // Записать переходный процесс системы с КУ.'#13#10</value>
     <textvalue></textvalue>
     <fconstant>'0'</fconstant>
     <script></script>
    </data>
