     <value>'const n = 8001; // Задать постоянное число точек массива.'#13#10'input y; // Объявить входные сигналы; число в скобках задаёт длину массива.'#13#10'output tt[n], yy[n]; // Объявить выходные сигналы для передачи данных другим блокам.'#13#10'initialization // Выполнить один раз при инициализации нового запуска.'#13#10'    for(i = 1, n) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    begin // Начало группы команд.'#13#10'        tt[i] =(i - 1) * LAB_DT; // Записать массив времени в выбранную ячейку [i].'#13#10'        yy[i] = 0; // Записать массив записанного выхода в выбранную ячейку [i].'#13#10'    end; // Конец группы команд или секции.'#13#10'end; // Конец группы команд или секции.'#13#10'i = round(time / LAB_DT) + 1; // Выбрать ячейку записи по текущему времени; нумерация начинается с 1.'#13#10'yy[i] = y; // Записать текущий выход системы в выбранную ячейку.'#13#10'LAB_H0 = yy; // Записать LAB_H0 в общую базу сигналов для других блоков и итоговой обработки.'#13#10'LAB_TIME = tt; // Записать LAB_TIME в общую базу сигналов для других блоков и итоговой обработки.'#13#10</value>
     <textvalue></textvalue>
     <fconstant>'0'</fconstant>
     <script></script>
    </data>
   </visual_props>
