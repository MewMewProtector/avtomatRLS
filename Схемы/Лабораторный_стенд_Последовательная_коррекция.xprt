    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'const n = 1401; // Задать постоянное число точек массива.'#13#10'output w1[n], y1[n], w2[n], y2[n]; // Объявить выходные сигналы для передачи данных другим блокам.'#13#10'var nr, ni, dr, di, oldr, asym0, asymj: double; // Объявить рабочие переменные; double хранит дробные числа.'#13#10'initialization // Выполнить один раз при инициализации нового запуска.'#13#10'    M0 =[[0]]; // Записать матрица числителя исходной ПФ.'#13#10'    D0 =[[0]]; // Записать матрица знаменателя исходной ПФ.'#13#10'    Mj =[[0]]; // Записать матрица числителя желаемой ПФ.'#13#10'    Dj =[[0]]; // Записать матрица знаменателя желаемой ПФ.'#13#10'    M0 = LAB_B0; // Прочитать общий сигнал LAB_B0: матрица числителя исходной ПФ.'#13#10'    D0 = LAB_A0; // Прочитать общий сигнал LAB_A0: матрица знаменателя исходной ПФ.'#13#10'    Mj = LAB_BJ; // Прочитать общий сигнал LAB_BJ: матрица числителя желаемой ПФ.'#13#10'    Dj = LAB_AJ; // Прочитать общий сигнал LAB_AJ: матрица знаменателя желаемой ПФ.'#13#10'    b0 = vector(cols(M0)); // Создать массив нужного размера: коэффициенты исходного числителя.'#13#10'    a0 = vector(cols(D0)); // Создать массив нужного размера: коэффициенты исходного знаменателя.'#13#10'    bj = vector(cols(Mj)); // Создать массив нужного размера: коэффициенты желаемого числителя.'#13#10'    aj = vector(cols(Dj)); // Создать массив нужного размера: коэффициенты желаемого знаменателя.'#13#10'    for(i = 1, cols(M0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        b0[i] = M0[1, i]; // Записать коэффициенты исходного числителя в выбранную ячейку [i].'#13#10'    for(i = 1, cols(D0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        a0[i] = D0[1, i]; // Записать коэффициенты исходного знаменателя в выбранную ячейку [i].'#13#10'    for(i = 1, cols(Mj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        bj[i] = Mj[1, i]; // Записать коэффициенты желаемого числителя в выбранную ячейку [i].'#13#10'    for(i = 1, cols(Dj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        aj[i] = Dj[1, i]; // Записать коэффициенты желаемого знаменателя в выбранную ячейку [i].'#13#10'    R0b =[[0]]; // Записать матрица частот исходных нулей.'#13#10'    R0a =[[0]]; // Записать матрица частот исходных полюсов.'#13#10'    Rjb =[[0]]; // Записать матрица частот желаемых нулей.'#13#10'    Rja =[[0]]; // Записать матрица частот желаемых полюсов.'#13#10'    R0b = LAB_R0B; // Прочитать общий сигнал LAB_R0B: матрица частот исходных нулей.'#13#10'    R0a = LAB_R0A; // Прочитать общий сигнал LAB_R0A: матрица частот исходных полюсов.'#13#10'    Rjb = LAB_RJB; // Прочитать общий сигнал LAB_RJB: матрица частот желаемых нулей.'#13#10'    Rja = LAB_RJA; // Прочитать общий сигнал LAB_RJA: матрица частот желаемых полюсов.'#13#10'    rb0 = vector(cols(R0b)); // Создать массив нужного размера: частоты исходных нулей.'#13#10'    ra0 = vector(cols(R0a)); // Создать массив нужного размера: частоты исходных полюсов.'#13#10'    rbj = vector(cols(Rjb)); // Создать массив нужного размера: частоты желаемых нулей.'#13#10'    raj = vector(cols(Rja)); // Создать массив нужного размера: частоты желаемых полюсов.'#13#10'    for(k = 1, cols(rb0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        rb0[k] = R0b[1, k]; // Записать частоты исходных нулей в выбранную ячейку [k].'#13#10'    for(k = 1, cols(ra0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        ra0[k] = R0a[1, k]; // Записать частоты исходных полюсов в выбранную ячейку [k].'#13#10'    for(k = 1, cols(rbj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        rbj[k] = Rjb[1, k]; // Записать частоты желаемых нулей в выбранную ячейку [k].'#13#10'    for(k = 1, cols(raj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        raj[k] = Rja[1, k]; // Записать частоты желаемых полюсов в выбранную ячейку [k].'#13#10'    wlo = LAB_WMIN; // Прочитать общий сигнал LAB_WMIN: нижняя граница частот.'#13#10'    whi = LAB_WMAX; // Прочитать общий сигнал LAB_WMAX: верхняя граница частот.'#13#10'    for(i = 1, n) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    begin // Начало группы команд.'#13#10'        omega = exp(ln(wlo) + ln(whi / wlo) *(i - 1) /(n - 1)); // Выбрать очередную частоту на равномерной логарифмической шкале.'#13#10'        nr = 0; // Записать действительная часть числителя.'#13#10'        ni = 0; // Записать мнимая часть числителя.'#13#10'        for(j = 1, cols(b0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            k = cols(b0) - j + 1; // Вычислить индекс элемента массива или коэффициента полинома.'#13#10'            oldr = nr; // Сохранить старую действительную часть числителя для следующей команды.'#13#10'            nr = b0[k] - omega * ni; // Шаг Горнера: новая действительная часть исходного числителя.'#13#10'            ni = omega * oldr; // Шаг Горнера: мнимая часть числителя из старой действительной.'#13#10'            k = k - 1; // Уменьшить k; на следующем проходе k снова задаётся явно.'#13#10'        end; // Конец группы команд или секции.'#13#10'        dr = 0; // Записать действительная часть знаменателя.'#13#10'        di = 0; // Записать мнимая часть знаменателя.'#13#10'        for(j = 1, cols(a0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            k = cols(a0) - j + 1; // Вычислить индекс элемента массива или коэффициента полинома.'#13#10'            oldr = dr; // Сохранить старую действительную часть знаменателя.'#13#10'            dr = a0[k] - omega * di; // Шаг Горнера: новая действительная часть исходного знаменателя.'#13#10'            di = omega * oldr; // Шаг Горнера: мнимая часть знаменателя из старой действительной.'#13#10'            k = k - 1; // Уменьшить k; на следующем проходе k снова задаётся явно.'#13#10'        end; // Конец группы команд или секции.'#13#10'        exact0 = 10 * ln((nr * nr + ni * ni) /(dr * dr + di * di)) / ln(10); // Вычислить 20*log10 модуля исходной ПФ, используя квадраты модулей.'#13#10'        nr = 0; // Записать действительная часть числителя.'#13#10'        ni = 0; // Записать мнимая часть числителя.'#13#10'        for(j = 1, cols(bj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            k = cols(bj) - j + 1; // Вычислить индекс элемента массива или коэффициента полинома.'#13#10'            oldr = nr; // Сохранить старую действительную часть числителя для следующей команды.'#13#10'            nr = bj[k] - omega * ni; // Шаг Горнера: новая действительная часть желаемого числителя.'#13#10'            ni = omega * oldr; // Шаг Горнера: мнимая часть числителя из старой действительной.'#13#10'            k = k - 1; // Уменьшить k; на следующем проходе k снова задаётся явно.'#13#10'        end; // Конец группы команд или секции.'#13#10'        dr = 0; // Записать действительная часть знаменателя.'#13#10'        di = 0; // Записать мнимая часть знаменателя.'#13#10'        for(j = 1, cols(aj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            k = cols(aj) - j + 1; // Вычислить индекс элемента массива или коэффициента полинома.'#13#10'            oldr = dr; // Сохранить старую действительную часть знаменателя.'#13#10'            dr = aj[k] - omega * di; // Шаг Горнера: новая действительная часть желаемого знаменателя.'#13#10'            di = omega * oldr; // Шаг Горнера: мнимая часть знаменателя из старой действительной.'#13#10'            k = k - 1; // Уменьшить k; на следующем проходе k снова задаётся явно.'#13#10'        end; // Конец группы команд или секции.'#13#10'        exactj = 10 * ln((nr * nr + ni * ni) /(dr * dr + di * di)) / ln(10); // Вычислить аналитическую желаемую ЛАЧХ в децибелах.'#13#10'        asym0 = LAB_BASE0 + 20 *(LAB_SLOPE0 / 20) * ln(omega) / ln(10); // Задать начальную асимптоту по усилению и наклону.'#13#10'        asymj = LAB_BASEJ + 20 *(LAB_SLOPEJ / 20) * ln(omega) / ln(10); // Задать начальную асимптоту по усилению и наклону.'#13#10'        for(k = 1, cols(rb0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            qlog = ln(omega / rb0[k]) / ln(10); // Найти десятичный логарифм отношения частоты к частоте излома.'#13#10'            asym0 = asym0 + 10 *(qlog + abs(qlog)); // Прибавить вклад нуля после частоты излома; до излома вклад равен нулю.'#13#10'        end; // Конец группы команд или секции.'#13#10'        for(k = 1, cols(ra0)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            qlog = ln(omega / ra0[k]) / ln(10); // Найти десятичный логарифм отношения частоты к частоте излома.'#13#10'            asym0 = asym0 - 10 *(qlog + abs(qlog)); // Вычесть вклад полюса после частоты излома; до излома вклад равен нулю.'#13#10'        end; // Конец группы команд или секции.'#13#10'        for(k = 1, cols(rbj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            qlog = ln(omega / rbj[k]) / ln(10); // Найти десятичный логарифм отношения частоты к частоте излома.'#13#10'            asymj = asymj + 10 *(qlog + abs(qlog)); // Прибавить вклад нуля после частоты излома; до излома вклад равен нулю.'#13#10'        end; // Конец группы команд или секции.'#13#10'        for(k = 1, cols(raj)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'        begin // Начало группы команд.'#13#10'            qlog = ln(omega / raj[k]) / ln(10); // Найти десятичный логарифм отношения частоты к частоте излома.'#13#10'            asymj = asymj - 10 *(qlog + abs(qlog)); // Вычесть вклад полюса после частоты излома; до излома вклад равен нулю.'#13#10'        end; // Конец группы команд или секции.'#13#10'        w1[i] = omega; // Передать текущая частота, рад/с в выход w1.'#13#10'        y1[i] = exactj; // Передать аналитическая желаемая ЛАЧХ, дБ в выход y1.'#13#10'        w2[i] = omega; // Передать текущая частота, рад/с в выход w2.'#13#10'        y2[i] = asymj; // Передать желаемая асимптота, дБ в выход y2.'#13#10'    end; // Конец группы команд или секции.'#13#10'end; // Конец группы команд или секции.'#13#10</value>
     <textvalue></textvalue>
     <fconstant>'0'</fconstant>
     <script></script>
    </data>
