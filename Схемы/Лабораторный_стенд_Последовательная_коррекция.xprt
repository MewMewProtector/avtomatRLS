    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'// НАСТРОЙКА ИСХОДНОЙ ПФ: свойства этого блока b0 и a0.'#13#10'// Коэффициенты задаются по возрастанию степени s: постоянный член, s, s^2 и далее.'#13#10'// Общий код страницы читает свойства и записывает LAB_B0/LAB_A0; здесь формируется пакет.'#13#10'output data[42]; // Объявить выходные сигналы для передачи данных другим блокам.'#13#10'bb =[[0]]; // Записать матрица коэффициентов числителя.'#13#10'aa =[[0]]; // Записать матрица коэффициентов знаменателя.'#13#10'bb = LAB_B0; // Прочитать общий сигнал LAB_B0: матрица коэффициентов числителя.'#13#10'aa = LAB_A0; // Прочитать общий сигнал LAB_A0: матрица коэффициентов знаменателя.'#13#10'data[1] = cols(bb); // Записать количество коэффициентов числителя в начало пакета.'#13#10'data[2] = cols(aa); // Записать количество коэффициентов знаменателя.'#13#10'for(i = 1, cols(bb)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    data[2 + i] = bb[1, i]; // Перенести очередной коэффициент числителя; первая позиция равна 3.'#13#10'for(i = 1, cols(aa)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    data[22 + i] = aa[1, i]; // Перенести очередной коэффициент знаменателя; первая позиция равна 23.'#13#10</value>
     <textvalue></textvalue>
     <fconstant>'0'</fconstant>
     <script></script>
    </data>
