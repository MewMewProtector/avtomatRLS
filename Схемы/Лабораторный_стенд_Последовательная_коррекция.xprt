    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'// Коэффициенты bk/ak рассчитывает общий код страницы как Wж/W0.'#13#10'// Этот блок выдаёт подготовленные LAB_BK/LAB_AK в пакете data.'#13#10'// Вход desired объявлен, но в текущих вычислениях не читается.'#13#10'input desired[42]; // Объявить входные сигналы; число в скобках задаёт длину массива.'#13#10'output data[42]; // Объявить выходные сигналы для передачи данных другим блокам.'#13#10'bb =[[0]]; // Записать матрица коэффициентов числителя.'#13#10'aa =[[0]]; // Записать матрица коэффициентов знаменателя.'#13#10'bb = LAB_BK; // Прочитать общий сигнал LAB_BK: матрица коэффициентов числителя.'#13#10'aa = LAB_AK; // Прочитать общий сигнал LAB_AK: матрица коэффициентов знаменателя.'#13#10'data[1] = cols(bb); // Записать количество коэффициентов числителя в начало пакета.'#13#10'data[2] = cols(aa); // Записать количество коэффициентов знаменателя.'#13#10'for(i = 1, cols(bb)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    data[2 + i] = bb[1, i]; // Перенести очередной коэффициент числителя; первая позиция равна 3.'#13#10'for(i = 1, cols(aa)) // Повторить следующие команды для всех указанных значений счётчика.'#13#10'    data[22 + i] = aa[1, i]; // Перенести очередной коэффициент знаменателя; первая позиция равна 23.'#13#10</value>
     <textvalue></textvalue>
     <fconstant>'0'</fconstant>
     <script></script>
    </data>
   </visual_props>
