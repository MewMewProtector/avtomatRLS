     <script>'initialization'#13#10'var str: string,'#13#10'i, n, Index: integer, '#13#10'buffer1, buffer2: double,'#13#10'TxtSize:complex = (1,1), '#13#10'TextPosX: double; '#13#10'  '#13#10'const FontSize = 8; '#13#10'const NStrdefault = "k·N(s)";'#13#10'const LStrdefault = "L(s)";'#13#10#13#10'//удаление динимческих объектов симовлов степени'#13#10'for (i= getobjcount,1,-1) begin'#13#10'   pr_id = getobj(i);'#13#10'   if (pos("Textsn_",getobjname(pr_id))'#62'0) then removeprimitiv(pr_id);'#13#10#9' if (pos("EnLine",getobjname(pr_id))'#62'0) then removeprimitiv(pr_id);  '#13#10'  end;'#13#10#13#10'//Форимрование знаменателя'#13#10' s = "";'#13#10' n = cols(a); //размер массива знаменателя'#13#10' numerator =  vector(n);'#13#10' shiftvector = vector(n-1);//vector смещения для показателей стпеней'#13#10' for (i=n, 2, -1) //формируем строку знаменателя'#13#10'  begin '#13#10#9'buffer1 = a[1,i]'#13#10#9'buffer2 = a[1,i-1]'#13#10#9'if (buffer1'#60#62'0) then  //выводим только если не 0.'#13#10#9'  begin'#13#10#9'  if (buffer1 = 1) then str = str + "s" else //единицу пропускаем'#13#10#9'   if (buffer1 = (-1)) then str = str + "-s" else //знак минуса если -1'#13#10#9'     str = str + FloatToStr(buffer1) + "s";'#13#10#9'  TxtSize = gettextsize(str,Text1.Font);'#13#10#9'  shiftvector[n-i+1] = real(TxtSize);'#13#10#9#9'//последняя s без пробела '#13#10'    if (i'#62'2) then'#13#10#9#9' begin'#13#10#9#9' //если отрицательное число то + нет'#13#10#9#9' if (buffer2'#60'=0) then str = str + " " else str = str + " +";'#13#10#9#9' end else '#13#10#9#9#9'//последние s с без пробела для показателя степени'#13#10#9'    if (buffer2'#62'0) then str = str + "+"; //(i=2)'#13#10#9#9'end  //buffer1'#60#62'0'#13#10#9#9#9'else '#13#10#9#9#9' if (buffer2'#62'0) then str = str + "+"; //добавляем плюс если следующее '#62'0  '#13#10#9'end; //for'#13#10' if (n=1) then str = FloatToStr(a[1,1]) else'#13#10'   if (buffer2'#60#62'0) then str = str + FloatToStr(buffer2); //eсли 0 то не выводим'#13#10' Text1.Text = str;'#13#10' //Вычисляем ширину текста знаменателя'#13#10' TxtSize = gettextsize(Text1.Text,Text1.Font);'#13#10' If (real(TxtSize) '#62' Width) then Text1.Text = LStrdefault //Строка по умолчанию'#13#10'  else '#13#10#9' begin'#13#10'   TextPosX = -real(TxtSize)/2; //начало текста при позиционирование по центру'#13#10'   //Линия дроби'#13#10'   pr_id = createprimitiv(0,[(-TextPosX,0),(TextPosX,0)]);'#13#10'   newname = "EnLine";                            '#13#10'   setpropasstring(pr_id,"Name",newname);'#13#10'   //формируем показатели степени'#13#10'   for (i=1, n-2)'#13#10#9'  if (a[1,n-i+1]'#60#62'0) then   '#13#10'    begin'#13#10#9'  pr_id = createprimitiv(29,[(TextPosX+shiftvector[i], 0)]);'#13#10#9'  newname = "Textsn_"+floattostr(i);                            '#13#10'    setpropasstring(pr_id,"Name",newname);'#13#10#9'  setpropasstring(pr_id,"Text",floattostr(n-i)); '#13#10'    setfontprop(pr_id, "size", FontSize);'#13#10#9'  end;//цикл показателя'#13#10#9' end;//строка умещается в блок'#13#10' //-------------------------------------------------------------------------'#13#10' //--------------------------------------------------------------------------'#13#10' //Создаем строку числителя '#13#10' str = "";'#13#10' n = cols(b); //размер массива числителя'#13#10' shiftvector = vector(n-1);//vector смещения для показателей стпеней'#13#10' if (n=1) then str = FloatToStr(b[1,1]); '#13#10' for (i=n, 2, -1) //формируем строку числитея'#13#10'  begin'#13#10#9'buffer1 = b[1,i]'#13#10#9'buffer2 = b[1,i-1]'#13#10#9'if (buffer1'#60#62'0) then  //выводим только если не 0.'#13#10#9' begin'#13#10#9' if (buffer1 = 1) then str = str + "s" else'#13#10#9'  if (buffer1 = (-1)) then str = str + "-s" else'#13#10#9'   str = str + FloatToStr(buffer1) + "s";'#13#10#9' TxtSize = gettextsize(str,Text1.Font);'#13#10#9' shiftvector[n-i+1] = real(TxtSize);'#13#10#9' //не последни s с пробелом для степени '#13#10'    if (i'#62'2) then'#13#10#9#9' begin'#13#10#9#9' //если отрицательное число то + нет'#13#10#9#9' if (buffer2'#60'=0) then str = str + " " else str = str + " +";'#13#10#9#9' end else '#13#10#9#9#9'//последние s  без пробела для показателя степени'#13#10#9'    if (buffer2'#62'0) then str = str + "+"; //(i=2)'#13#10#9' end'#9'//(buffer1'#60#62'0) '#13#10#9'  else // проверяем что идет за 0'#13#10#9#9#9' if (buffer2'#62'0) then str = str + "+"; //добавляем плюс если следующее '#62'0'#13#10#9'end; //for'#13#10#9'if (n=1) then str = FloatToStr(b[1,1]) else'#13#10'   if (buffer2'#60#62'0) then str = str + FloatToStr(buffer2);'#13#10' Text.Text = str;'#13#10#13#10' //Вычисляем ширину текста числителя'#13#10' TxtSize = gettextsize(Text.Text,Text.Font);'#13#10' If (real(TxtSize)'#62'Width) then Text.Text = NStrdefault //Строка по умолчанию'#13#10'  else '#13#10#9' begin'#13#10'   TextPosX = -real(TxtSize)/2; //начало текста при позиционирование по центру'#13#10'   //формируем показатели степени'#13#10#9' for (i=1, n-2)'#13#10#9#9'if (b[1,n-i+1]'#60#62'0) then'#13#10'     begin'#13#10#9'   pr_id = createprimitiv(29,[(TextPosX+shiftvector[i], -16)]);'#13#10#9'   newname = "Textsn_2"+floattostr(i);                            '#13#10'     setpropasstring(pr_id,"Name",newname);'#13#10#9'   setpropasstring(pr_id,"Text",floattostr(n-i)); '#13#10'     setfontprop(pr_id, "size", FontSize);'#13#10#9'   end;'#13#10#9' end;//строка уменьшается в блок'#13#10'end;'</script>
