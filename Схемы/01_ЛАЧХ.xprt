    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'const n=1401;'#13#10'output w[n], le[n], la[n];'#13#10'initialization'#13#10' for (i=1,n) begin'#13#10' w[i]=10^(-3+7*(i-1)/(n-1));'#13#10' z=complex(0,w[i]);'#13#10''#13#10' v=5*(2*z+1)/(z*(2.5*z+1)*(z+1)*(.8*z+1)*(.5*z+1));'#13#10' le[i]=20*ln(abs(v))/ln(10);'#13#10' la[i]=20*ln(5/w[i])/ln(10)'#13#10' +20*max(0,ln(2*w[i])/ln(10))'#13#10' -20*max(0,ln(2.5*w[i])/ln(10))'#13#10' -20*max(0,ln(w[i])/ln(10))'#13#10' -20*max(0,ln(.8*w[i])/ln(10))'#13#10' -20*max(0,ln(.5*w[i])/ln(10));'#13#10' end;'#13#10'end;'#13#10''</value>
     <textvalue/>
     <fconstant>'0'</fconstant>
     <script/>
    </data>
