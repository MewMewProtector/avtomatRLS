    <data>
     <name>'Script'</name>
     <caption>'Интерпретируемый скрипт'</caption>
     <type>'8'</type>
     <mode>'2'</mode>
     <value>'const n=1401;'#13#10'output w[n], le[n], la[n];'#13#10'initialization'#13#10' for (i=1,n) begin'#13#10' w[i]=10^(-3+7*(i-1)/(n-1));'#13#10' z=complex(0,w[i]);'#13#10''#13#10' v=10.0530964914873/(z*(.05*z+1)*(.015*z+1)*(.001*z+1));'#13#10' le[i]=20*ln(abs(v))/ln(10);'#13#10' la[i]=20*ln(10.0530964914873/w[i])/ln(10)'#13#10' -20*max(0,ln(.05*w[i])/ln(10))'#13#10' -20*max(0,ln(.015*w[i])/ln(10))'#13#10' -20*max(0,ln(.001*w[i])/ln(10));'#13#10' end;'#13#10'end;'#13#10''</value>
     <textvalue/>
     <fconstant>'0'</fconstant>
     <script/>
    </data>
