     <type>'2'</type>
     <mode>'1'</mode>
     <value>'0'</value>
     <textvalue></textvalue>
     <fconstant>'1'</fconstant>
     <script>'ONAPPLYSCRIPT'#13#10#9'if Self.ReduceDeg then'#13#10'    Self.InvisibleProps = StringReplaceAll(Self.InvisibleProps, "ReduceTol;", "")'#13#10#9'else'#13#10#9#9'Self.InvisibleProps += "ReduceTol;";'#9#13#10'ENDSCRIPT'#13#10#13#10'REFRESH'</script>
    </data>
    <data>
