    <data>
     <name>'ffdcalcmode'</name>
     <caption>'Режим расчёта характеристик'</caption>
     <type>'15'</type>
     <mode>'1'</mode>
     <value>
      <items>'В начале расчёта'#13#10'В конце расчёта'#13#10'С заданным шагом'</items>
      <index>'0'</index>
     </value>
     <textvalue></textvalue>
     <fconstant>'1'</fconstant>
     <script>'ONAPPLYSCRIPT'#13#10#9'if Self.ffdcalcmode = 2 then'#13#10'    Self.InvisibleProps = StringReplaceAll(Self.InvisibleProps, "ffdtimestep;", "")'#13#10#9'else'#13#10#9#9'Self.InvisibleProps += "ffdtimestep;";'#9#13#10'ENDSCRIPT'#13#10#13#10'REFRESH'</script>
    </data>
