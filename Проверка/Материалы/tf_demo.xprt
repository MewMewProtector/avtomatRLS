     <value>'const N=[20 20],                        {полином числителя}'#13#10'      D=[0 1 10.13 1.314 0.1405 0.005]; {полином знаменателя}'#13#10'const f1=1e-2, fk=1e3{, k=2};   //?'#13#10'output f[k],L[k],fi[k],re[k],im[k];'#13#10#13#10'initialization'#13#10'  fi0=0;'#13#10'  for (i=1,k) '#13#10'  begin'#13#10'    f[i]=f1*(fk/f1)^((i-1)/(k-1));'#13#10'//    c=1i*f[i];'#13#10'    c=complex(0,f[i]);'#13#10'    cN=polyval(N,c); c=polyval(D,c);'#13#10'    if abs(c)'#62'0 then c=cN/c;'#13#10'    a=abs(c);'#13#10'    if a'#62'0 then L[i]=20*ln(a)/ln(10) else L[i]=-100;'#13#10'    fi[i]=arg(c)*180/pi;'#13#10'    while abs(fi[i]-fi0)'#62'180 do'#13#10'      if (fi[i]-fi0)'#62'180 then fi[i]=fi[i]-360 else fi[i]=fi[i]+360;'#13#10'    fi0=fi[i];'#13#10'    re[i]=real(c); im[i]=imag(c);'#13#10'  end;'#13#10'end;'#13#10#13#10#13#10</value>
